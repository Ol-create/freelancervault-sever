# Copy to .env and fill in real values. Never commit the real .env.

# Postgres connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/freelancervault?schema=public"

# Backend HTTP port
PORT=3000

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"

# Flutterwave (test/sandbox keys during development)
FLW_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
FLW_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
# Webhook signature verification — compare against the `verif-hash` header.
FLW_SECRET_HASH="replace-with-the-hash-you-set-in-the-flutterwave-dashboard"
# Defaults to Flutterwave production v3. Point at developersandbox-api.flutterwave.com
# with the appropriate versioned path only when using the provider's sandbox.
FLW_API_BASE_URL="https://api.flutterwave.com/v3"

# KYC document/selfie uploads are performed directly with the chosen provider.
# Store provider references only; do not send raw document files to this API.
KYC_PROVIDER="unconfigured"

# Redis (BullMQ job queue)
REDIS_URL="redis://localhost:6379"

# Crypto (Phase 2)
CHAIN_RPC_URL="https://polygon-rpc.com"
STABLECOIN_CONTRACT_ADDRESS=""
